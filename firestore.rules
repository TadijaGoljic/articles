rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User-owned data: only the owner can read/write their own data
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User profile: any authenticated user can read (needed for email lookup)
    // Only the owner can write
    match /users/{uid}/profile/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Allow any authenticated user to update another user's group with isShared/sharedGroupId
    // (written during invitation acceptance)
    match /users/{uid}/groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null &&
        (request.auth.uid == uid ||
         // Invitation acceptance: only allow setting isShared + sharedGroupId fields
         (request.resource.data.keys().hasOnly(['isShared', 'sharedGroupId']) == false &&
          request.auth.uid != uid) == false);
    }

    // Invitations: sender creates, either party can read/update
    match /invitations/{invitationId} {
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid;
      allow read, update: if request.auth != null &&
        (request.auth.uid == resource.data.toUid ||
         request.auth.uid == resource.data.fromUid);
    }

    // Shared groups: members can read and write
    match /sharedGroups/{groupId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.members;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.members;

      match /articles/{articleId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/sharedGroups/$(groupId)).data.members;
      }
    }

  }
}
